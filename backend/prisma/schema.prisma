datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  displayName String
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id     String           @id @default(uuid())
  code   String           @unique
  name   String
  module String
  roles  RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(uuid())
  username           String     @unique
  email              String     @unique
  passwordHash       String
  fullName           String
  phone              String?
  roleId             String
  role               Role       @relation(fields: [roleId], references: [id])
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  createdContracts   Contract[] @relation("ContractCreator")
  auditLogs          AuditLog[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([roleId])
  @@map("users")
}

model Customer {
  id             String     @id @default(uuid())
  customerNumber String     @unique
  fullName       String
  phone          String
  nationalId     String?
  address        String?
  governorate    String?
  notes          String?
  contracts      Contract[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([phone])
  @@index([nationalId])
  @@map("customers")
}

model ContractType {
  id          String             @id @default(uuid())
  name        String             @unique
  code        String             @unique
  description String?
  icon        String?
  isActive    Boolean            @default(true)
  templates   ContractTemplate[]
  contracts   Contract[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("contract_types")
}

model ContractTemplate {
  id                 String          @id @default(uuid())
  contractTypeId     String
  contractType       ContractType    @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)
  name               String
  termsAndConditions String?
  printLayoutConfig  String?
  isDefault          Boolean         @default(true)
  fields             ContractField[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("contract_templates")
}

model ContractField {
  id          String           @id @default(uuid())
  templateId  String
  template    ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey    String
  label       String
  fieldType   String
  isRequired  Boolean          @default(false)
  options     String?
  section     String           @default("details")
  orderIndex  Int              @default(0)
  placeholder String?
  values      ContractValue[]

  @@map("contract_fields")
}

model Contract {
  id             String          @id @default(uuid())
  contractNumber String          @unique
  contractTypeId String
  contractType   ContractType    @relation(fields: [contractTypeId], references: [id])
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  createdById    String
  createdBy      User            @relation("ContractCreator", fields: [createdById], references: [id])
  issueDate      DateTime        @default(now())
  startDate      DateTime
  endDate        DateTime?
  status         String          @default("ACTIVE")
  totalAmount    Float           @default(0.0)
  paymentMethod  String          @default("CASH")
  notes          String?
  isArchived     Boolean         @default(false)
  deletedAt      DateTime?
  values         ContractValue[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([contractNumber])
  @@index([customerId])
  @@index([contractTypeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([isArchived, deletedAt])
  @@map("contracts")
}

model ContractValue {
  id         String        @id @default(uuid())
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fieldId    String
  field      ContractField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value      String?

  @@unique([contractId, fieldId])
  @@map("contract_values")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("settings")
}
