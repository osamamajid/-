# ==========================================
# متغيرات البيئة لنظام عَقيد - Aqeed
# ==========================================

# المنفذ وبيئة التشغيل
PORT=5000
NODE_ENV=development

# رابط قاعدة البيانات (SQLite للتطوير الفوري)
DATABASE_URL="file:./dev.db"

# رابط قاعدة البيانات عند استخدام PostgreSQL أو Docker Compose
# DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/aqeed_db?schema=public"

# مفاتيح الأمان JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN="7d"

# رابط الواجهة المسموح بها في CORS
CORS_ORIGIN="http://localhost:5173"

# متغيرات الواجهة الأمامية (Frontend)
VITE_API_URL=

